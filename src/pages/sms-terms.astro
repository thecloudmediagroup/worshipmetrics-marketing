---
import Layout from "../layouts/Layout.astro";

// SOURCE OF TRUTH: the wording below mirrors `shared/sms-terms.ts` in the
// WorshipMetricscom app repo (SMS_PROGRAM_NAME, SMS_OPT_IN_DISCLOSURE,
// SMS_FREQUENCY, SMS_HELP_REPLY, SMS_STOP_REPLY, SMS_START_REPLY,
// SMS_TERMS_SECTIONS). Carriers compare the opt-in form, this page and the
// STOP/START/HELP auto-replies against each other during A2P 10DLC review, so
// change that file first and copy the result here — never edit one alone.

const UPDATED = "September 28, 2026";

const PROGRAM_NAME = "WorshipMetrics Sunday readiness texts";
const SUPPORT_EMAIL = "support@worshipmetrics.com";
const SUPPORT_PHONE = "(910) 967-7447";
const FREQUENCY = "Message frequency varies, usually a few messages a week around your services";

// Shown beside the in-app opt-in checkbox and stored verbatim with each consent.
const OPT_IN_DISCLOSURE =
  "Yes, text me Sunday readiness alerts from WorshipMetrics at this number: a heads-up before a service " +
  "when something in the booth needs attention, and urgent problems during a service. " +
  `${FREQUENCY}. Message and data rates may apply. Reply HELP for help or STOP to cancel at any time. ` +
  "Consent is not a condition of any purchase. SMS terms: worshipmetrics.com/sms-terms. " +
  "Privacy policy: worshipmetrics.com/privacy.";

// Required carrier / Twilio A2P 10DLC statement. Keep verbatim; it also appears on /privacy.
const NO_SHARING_STATEMENT =
  "No mobile information will be shared with third parties or affiliates for marketing or promotional purposes. " +
  "Information sharing to subcontractors in support services, such as customer service, is permitted. " +
  "All other use case categories exclude text messaging originator opt-in data and consent; " +
  "this information will not be shared with any third parties.";

const AUTO_REPLIES = [
  {
    keyword: "HELP",
    text: `${PROGRAM_NAME}. Help: ${SUPPORT_EMAIL} or ${SUPPORT_PHONE}. Msg & data rates may apply. Reply STOP to cancel.`,
  },
  {
    keyword: "STOP",
    text: "WorshipMetrics: you're unsubscribed and will receive no more texts from this number. Reply START to resubscribe.",
  },
  {
    keyword: "START",
    text: "WorshipMetrics: you're resubscribed. Msg frequency varies. Msg & data rates may apply. Reply HELP for help, STOP to cancel.",
  },
];

const sections = [
  {
    title: "1. What these texts are",
    body:
      `${PROGRAM_NAME} are operational alerts for the people who run a church's audio, video and livestream: ` +
      "a heads-up before a service when something in the booth needs attention, and urgent problems during a service. " +
      "They are never marketing or promotional messages.",
  },
  {
    title: "2. The kinds of messages we send",
    body:
      "WorshipMetrics sends three kinds of text messages, all of them transactional or operational: " +
      "(a) Sunday readiness alerts to the church staff and volunteers who opted in, as described above; " +
      "(b) internal staff alerts to our own on-call WorshipMetrics employees when a customer's system needs attention; and " +
      "(c) support ticket status updates to a person who opened a support ticket with us and asked to be texted about it. " +
      "We do not send promotional or marketing texts, and nobody can be added to any of these lists by someone else.",
  },
  {
    title: "3. How you sign up",
    body:
      "You opt in yourself, in the WorshipMetrics app under Pulse > Alerts > Notification settings, by entering your " +
      "mobile number and ticking the consent box. We record the time, the number and the exact wording you agreed to. " +
      "Nobody else can opt you in, and Sunday readiness texts go only to numbers that opted in. " +
      "Consent to receive text messages is not a condition of any purchase.",
  },
  {
    title: "4. How often",
    body: `${FREQUENCY}. Message and data rates may apply, depending on your mobile plan.`,
  },
  {
    title: "5. How to stop",
    body:
      "Reply STOP to any message to cancel; you will get one confirmation and nothing further from that number. " +
      "Reply START to sign up again. You can also turn texts off at any time in Notification settings.",
  },
  {
    title: "6. How to get help",
    body: `Reply HELP to any message, email ${SUPPORT_EMAIL}, or call ${SUPPORT_PHONE}.`,
  },
  {
    title: "8. Carriers",
    body: "Wireless carriers are not liable for delayed or undelivered messages. Delivery is not guaranteed.",
  },
];
---

<Layout
  title="SMS Terms and Conditions"
  description="Terms for WorshipMetrics Sunday readiness texts and our other SMS programs: what the messages are, how you opt in, message frequency, how to stop (STOP), how to get help (HELP), and how we protect your mobile number."
  canonical="/sms-terms"
  robots="index,follow"
>
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">SMS Terms and Conditions</h1>
      <p class="mt-4 text-base leading-relaxed text-slate-600">
        Effective {UPDATED}. These terms cover <strong class="text-slate-900">{PROGRAM_NAME}</strong> and the other
        text messages WorshipMetrics sends. They work together with our
        <a href="/terms" class="font-semibold text-indigo-600 hover:text-indigo-800">Terms of Service</a> and
        <a href="/privacy" class="font-semibold text-indigo-600 hover:text-indigo-800">Privacy Policy</a>.
      </p>
    </div>
  </section>

  <section class="bg-white px-4 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl space-y-8">
      {sections.slice(0, 3).map(({ title, body }) => (
        <div>
          <h2 class="text-xl font-bold text-slate-900">{title}</h2>
          <p class="mt-2 text-base leading-relaxed text-slate-600">{body}</p>
        </div>
      ))}

      <div>
        <h3 class="text-base font-semibold text-slate-900">The consent wording you agree to</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          This is the exact text shown beside the opt-in checkbox in the app, and it is stored with your consent record:
        </p>
        <blockquote class="mt-3 rounded-2xl border border-slate-200 bg-slate-50 p-5 text-sm leading-relaxed text-slate-700">
          {OPT_IN_DISCLOSURE}
        </blockquote>
      </div>

      {sections.slice(3, 6).map(({ title, body }) => (
        <div>
          <h2 class="text-xl font-bold text-slate-900">{title}</h2>
          <p class="mt-2 text-base leading-relaxed text-slate-600">{body}</p>
        </div>
      ))}

      <div>
        <h3 class="text-base font-semibold text-slate-900">What you will get back</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          Replying to any message with one of these keywords sends the reply shown:
        </p>
        <dl class="mt-3 space-y-3">
          {AUTO_REPLIES.map(({ keyword, text }) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
              <dt class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Reply {keyword}</dt>
              <dd class="mt-1 text-sm leading-relaxed text-slate-700">{text}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div id="privacy">
        <h2 class="text-xl font-bold text-slate-900">7. Your number and privacy</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-600">
          We use your mobile number only to send the texts you signed up for. Mobile numbers and text opt-in consent
          are never sold, rented or shared with third parties or affiliates for their marketing or promotional purposes.
        </p>
        <p class="mt-3 text-base leading-relaxed">
          <strong class="text-slate-900">{NO_SHARING_STATEMENT}</strong>
        </p>
        <p class="mt-3 text-base leading-relaxed text-slate-600">
          Our full
          <a href="/privacy#sms" class="font-semibold text-indigo-600 hover:text-indigo-800">Privacy Policy</a>
          explains how we handle your mobile number and messaging data.
        </p>
      </div>

      {sections.slice(6).map(({ title, body }) => (
        <div>
          <h2 class="text-xl font-bold text-slate-900">{title}</h2>
          <p class="mt-2 text-base leading-relaxed text-slate-600">{body}</p>
        </div>
      ))}

      <div>
        <h2 class="text-xl font-bold text-slate-900">9. Contact</h2>
        <p class="mt-2 text-base leading-relaxed text-slate-600">
          Questions about these texts? Email
          <a href={`mailto:${SUPPORT_EMAIL}`} class="font-semibold text-indigo-600 hover:text-indigo-800">{SUPPORT_EMAIL}</a>
          or call
          <a href="tel:+19109677447" class="font-semibold text-indigo-600 hover:text-indigo-800">{SUPPORT_PHONE}</a>.
          We&apos;re real people and we actually answer.
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
        <p class="text-sm leading-relaxed text-slate-600">
          Plain-English summary (not a substitute for the sections above): you turn these texts on yourself in the app,
          they are booth alerts and never advertising, they arrive a few times a week around your services, reply STOP
          to end them or HELP for help, and we never hand your number to anyone for marketing.
        </p>
      </div>
    </div>
  </section>
</Layout>
